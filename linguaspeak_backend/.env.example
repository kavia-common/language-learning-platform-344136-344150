# Linguaspeak backend environment variables
#
# IMPORTANT:
# - Do not commit real secrets. Use .env locally / deployment config in production.
# - If POSTGRES_URL is not set, the backend will attempt to derive it from:
#   ../language-learning-platform-344136-344151/linguaspeak_database/db_connection.txt

# Optional override for DB connection
# POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT configuration
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=240

# CORS origins (comma-separated) or '*' for all
CORS_ALLOW_ORIGINS=*
